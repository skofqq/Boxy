#!/system/bin/sh

get_current_ssid() {
  SSID=$(cmd wifi status 2>/dev/null | sed -n 's/.*SSID: "\([^"]*\)".*/\1/p' | head -n1)

  if [ -z "$SSID" ] || [ "$SSID" = "<unknown ssid>" ]; then
    SSID=$(iwconfig wlan0 2>/dev/null | grep 'ESSID' | busybox awk -F ':' '{print $2}' | tr -d '"')
    if [ -z "$SSID" ] || [ "$SSID" = "off/any" ]; then
      echo "unknown"
    else
      echo "$SSID"
    fi
  else
    echo "$SSID"
  fi
}

get_current_bssid() {
  cmd wifi status 2>/dev/null | sed -n 's/.*BSSID: \([0-9A-Fa-f:]\{17\}\).*/\1/p' | head -n1 | tr 'A-F' 'a-f'
}

is_wifi_connected() {
  wifi_enabled=$(dumpsys wifi | grep 'Wi-Fi is enabled')
  wifi_ip=$(ip addr show wlan0 | grep 'inet ' | busybox awk '{print $2}' | cut -d/ -f1)

  if [ -n "$wifi_enabled" ] && [ -n "$wifi_ip" ]; then
    echo "wifi"
  else
    echo "not_wifi"
  fi
}

# Operator names and MCC+MNC codes of the SIM used for mobile data, one per line.
# On dual SIM phones the data SIM is picked when the slot can be found; otherwise all SIMs are listed.
get_sim_operators() {
  local alpha numeric sub slot
  alpha=$(getprop gsm.sim.operator.alpha)
  numeric=$(getprop gsm.sim.operator.numeric)
  [ -z "$alpha" ] && alpha=$(getprop gsm.operator.alpha)
  [ -z "$numeric" ] && numeric=$(getprop gsm.operator.numeric)
  sub=$(settings get global multi_sim_data_call 2>/dev/null)
  slot=$(dumpsys isub 2>/dev/null | grep -E "id=${sub}[ ,]" | grep -oE "simSlotIndex=[0-9]+" | head -n1 | cut -d= -f2)
  if echo "$alpha$numeric" | grep -q ',' && [ -n "$slot" ]; then
    echo "$alpha" | cut -d, -f$((slot + 1))
    echo "$numeric" | cut -d, -f$((slot + 1))
  else
    echo "$alpha" | tr ',' '\n'
    echo "$numeric" | tr ',' '\n'
  fi
}

# 0 when the current SIM operator is in sim_operators_list (case-insensitive).
is_listed_sim() {
  local ops item
  ops=$(get_sim_operators | busybox awk 'NF')
  for item in "${sim_operators_list[@]}"; do
    item=$(echo "$item" | xargs)
    [ -z "$item" ] && continue
    echo "$ops" | grep -qixF -- "$item" && return 0
  done
  return 1
}

is_allowed_wifi() {
  ssid_list="$(IFS=,; echo "${wifi_ssids_list[*]}")"

  local ssid=$(echo "$1" | xargs)
  local list="$ssid_list"

  IFS=','
  for allowed in $list; do
    allowed=$(echo "$allowed" | xargs)
    if [ "$ssid" = "$allowed" ]; then
      return 0
    fi
  done

  # Also match the router MAC (BSSID) when wifi_bssids_list is set.
  if [ -n "${wifi_bssids_list[*]}" ]; then
    local bssid=$(get_current_bssid)
    if [ -n "$bssid" ]; then
      for allowed in "${wifi_bssids_list[@]}"; do
        allowed=$(echo "$allowed" | tr 'A-F' 'a-f' | xargs)
        if [ "$bssid" = "$allowed" ]; then
          return 0
        fi
      done
    fi
  fi
  return 1
}