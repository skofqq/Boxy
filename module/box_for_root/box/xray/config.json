// Box for Root: example Xray config (Xray 26). It has no proxy server yet, so everything goes direct.
// Import a subscription in Boxy (Tools → Import subscription) or replace this file with your own config.
// Every *.json in this folder is loaded together (a config may be split into files); Boxy's own files are
// named zz-boxy-*.json.
{
  // loglevel: debug, info, warning, error, none. The log is /data/adb/box/run/xray.log
  "log": {
    "loglevel": "warning"
  },
  // DNS servers Xray resolves domain names with (Android has no /etc/resolv.conf for it).
  "dns": {
    "servers": [
      "1.1.1.1",
      "8.8.8.8"
    ]
  },
  // Where traffic comes in. The module sends the phone's traffic to the tproxy port of settings.ini (tproxy_port)
  // and keeps "port" of the inbound tagged tproxy-in in sync with it. Xray runs in tproxy mode only.
  "inbounds": [
    {
      "tag": "tproxy-in",
      "port": 9898,
      "protocol": "dokodemo-door",
      "settings": {
        // Take the original destination of redirected connections.
        "followRedirect": true,
        "network": "tcp,udp"
      },
      // Read the domain from HTTP / TLS, so routing rules by domain work.
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls"
        ]
      },
      "streamSettings": {
        "sockopt": {
          "tproxy": "tproxy"
        }
      }
    }
  ],
  // Where traffic goes. Put your server first, for example (all REPLACE_ME values are yours to fill in):
  // {
  //   "tag": "proxy",                   // the name routing refers to
  //   "protocol": "vless",              // vless, vmess, trojan, shadowsocks, hysteria, ...
  //   "settings": {
  //     "vnext": [{
  //       "address": "REPLACE_ME.example.com",
  //       "port": 443,
  //       "users": [{ "id": "REPLACE_ME", "encryption": "none", "flow": "xtls-rprx-vision" }]
  //     }]
  //   },
  //   "streamSettings": {
  //     "network": "tcp",
  //     "security": "reality",          // or "tls": "tlsSettings": { "serverName": "..." }
  //     "realitySettings": {
  //       "serverName": "REPLACE_ME.example.com",
  //       "fingerprint": "chrome",
  //       "publicKey": "REPLACE_ME",
  //       "shortId": "REPLACE_ME"
  //     }
  //   }
  // },
  // A server with a self-signed certificate: "allowInsecure" no longer exists in Xray 26. Pin its certificate
  // instead with "pinnedPeerCertSha256" in tlsSettings (get the hash with: xray tls ping <domain>).
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    },
    {
      "protocol": "dns",
      "tag": "dns-out"
    }
  ],
  // Routing: rules are checked top down; traffic no rule matches goes to the first outbound ("direct" here).
  // With a server above, add a last rule { "network": "tcp,udp", "outboundTag": "proxy" }.
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        // DNS queries of the apps go to Xray's DNS (the servers above).
        "inboundTag": [
          "tproxy-in"
        ],
        "port": 53,
        "outboundTag": "dns-out"
      }
    ]
  }
}
